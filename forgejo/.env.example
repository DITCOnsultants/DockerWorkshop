# ============================================================
# Forgejo deployment — environment variables
# Copy to .env and fill in values. Never commit .env to git.
# ============================================================

# Forgejo system account — populated automatically by the sed commands in the README
FORGEJO_UID=fill_with_forgejo_uid
FORGEJO_GID=fill_with_forgejo_gid
DOCKER_GID=fill_with_docker_gid

# Admin user created on first boot
ADMIN_USER=forgejo-admin
ADMIN_PASSWORD=changeme
ADMIN_EMAIL=admin@localhost

# Secret keys — generate with: openssl rand -hex 32
FORGEJO_SECRET_KEY=changeme_generate_with_openssl_rand_hex_32
FORGEJO_INTERNAL_TOKEN=changeme_generate_with_openssl_rand_hex_32

# Server
FORGEJO_DOMAIN=localhost
FORGEJO_ROOT_URL=http://localhost:3000
FORGEJO_HTTP_PORT=3000
FORGEJO_SSH_PORT=2222

# Versions
FORGEJO_VERSION=15
RUNNER_VERSION=12

# Optional: migrate a public repo from GitHub (or any Git host) on first boot
# Leave empty to skip. The repo name is derived from the URL.
SEED_REPO_URL=https://github.com/DITCOnsultants/DockerWorkshop

# Runner
RUNNER_NAME=default-runner
# Comma-separated list of labels: <runs-on-label>:docker://<image>
# The image is what job steps actually run inside.
RUNNER_LABELS=ubuntu-latest:docker://catthehacker/ubuntu:act-latest

# Logging (debug, info, warn, error)
FORGEJO_LOG_LEVEL=warn
